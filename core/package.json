{
  "name": "noteify-core",
  "version": "1.0.0",
  "description": "Shared library and type definitions of the Noteify project",
  "main": "lib/main/index.js",
  "typings": "lib/main/index.d.ts",
  "module": "lib/module/index.js",
  "scripts": {
    "build": "run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --ext .ts --fix",
    "test": "run-s build test:*",
    "test:lint": "eslint src --ext .ts",
    "test:prettier": "prettier \"src/**/*.ts\" --list-different",
    "test:unit": "ava",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "ava --watch",
    "doc": "run-s doc:html && open-cli lib/docs/index.html",
    "doc:html": "typedoc src/ --exclude **/*.spec.ts --out lib/docs",
    "doc:json": "typedoc src/ --exclude **/*.spec.ts --json lib/docs/typedoc.json"
  },
  "devDependencies": {
    "@ava/typescript": "^3.0.1",
    "@eslint/js": "^9.29.0",
    "ava": "^5.2.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "lint-staged": "^13.1.2",
    "npm-run-all": "^4.1.5",
    "open-cli": "^7.0.1",
    "prettier": "3.6.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.23.10",
    "typescript": "^4.3.2",
    "typescript-eslint": "^8.35.0"
  },
  "files": [
    "lib/main",
    "lib/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "rewritePaths": {
        "src/": "lib/main/"
      },
      "compile": false
    },
    "files": [
      "!lib/module/**"
    ]
  }
}